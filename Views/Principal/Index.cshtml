@model IEnumerable<BaseDoc_OI_GRC.Models.Document>
@{
    ViewBag.Title = "Documents";
}

<h2>Documents</h2>

@if (Request.IsAuthenticated)
{
    <div class="btn-group" style="margin-bottom:10px;">
        <a id="bouton-actualiser" class="btn btn-default bouton-actualiser" href="@Url.Action("ActualiserDocuments", "Principal")">Actualiser depuis le répertoire</a>
        <button id="bouton-supprimer" type="button" class="btn btn-danger bouton-supprimer">Supprimer la sélection</button>
    </div>
}

<div class="table-responsive">
    <table id="table-documents" class="table table-striped table-bordered">
        <thead>
            <tr>
                @if (Request.IsAuthenticated)
                {
                    <th class="colCheckbox"><input type="checkbox" class="mainCheckbox" /></th>
                }
                <th>Code</th>
                <th>Titre</th>
                <th>Type</th>
                <th>Référentiel</th>
                <th>Secteur</th>
                <th class="table-entete-telechargement">Télécharger</th>
                @if (Request.IsAuthenticated)
                {
                    <th class="table-entete-modification">Modifier</th>
                }
            </tr>
        </thead>
        @{ Html.RenderPartial("TableBodyDocuments", Model); }
    </table>
</div>
